# Copy to .env and fill in. Never commit .env.
MISTRAL_API_KEY=
# Optional, defaults to mistral-small-latest
MISTRAL_MODEL=
# Optional Voxtral preset voice, defaults to gb_jane_neutral
VOXTRAL_VOICE=
# Jev (TypeSafe) judge for `pnpm eval`. Not used by the app.
TYPESAFE_API_KEY=
# Optional, defaults to jev-latest
JEV_MODEL=
