# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Optional, defaults to mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_MODEL=
# Optional Voxtral preset voice, defaults to gb_jane_neutral
VOXTRAL_VOICE=
# Optional Langfuse Cloud traces. The app runs without them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional, defaults to https://cloud.langfuse.com
LANGFUSE_BASE_URL=
# Where the web server forwards /api calls. Server-side only. Defaults to http://127.0.0.1:8000.
API_URL=
# Shared by the web server and the API. When set, the API only answers the web server. Set it in production.
PROXY_SECRET=
# Optional API limits, calls per minute. One spoken question makes three calls. Defaults: 30 per visitor, 300 in total.
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_GLOBAL_PER_MINUTE=
# Optional, comma-separated. Extra origins allowed to call the API directly, without the web server.
ALLOWED_ORIGINS=
# Optional. Makes the browser call another API base instead of /api.
VITE_API_URL=
# Jev (TypeSafe) judge for `pnpm eval`. Not used by the app.
TYPESAFE_API_KEY=
# Optional, defaults to jev-latest
JEV_MODEL=
