# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Optional, defaults to mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_MODEL=
# Optional Voxtral preset voice, defaults to gb_jane_neutral
VOXTRAL_VOICE=
# Optional Langfuse Cloud traces. The app runs without them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional, defaults to https://cloud.langfuse.com
LANGFUSE_BASE_URL=
# Optional. The browser calls this API. Defaults to http://127.0.0.1:8000.
VITE_API_URL=
# Jev (TypeSafe) judge for `pnpm eval`. Not used by the app.
TYPESAFE_API_KEY=
# Optional, defaults to jev-latest
JEV_MODEL=
